/blocks/*/node_modules export-ignore
/node_modules export-ignore
/tests export-ignore
/phpunit.xml export-ignore

# docs/ is public reference for GitHub readers and stays out of Composer
# archives; designs/ is a guard, since mockups live in the private
# imagewize.com repo (see CLAUDE.md). Kept in step with .distignore.
/docs export-ignore
/designs export-ignore
/bin export-ignore
/.agents export-ignore
/.vibe export-ignore
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore

# Vendored third-party library, unmodified apart from one documented line of
# slick-theme.css. linguist-vendored keeps 3k lines of Slick out of the repo's
# language stats; -diff on the font stops GitHub's rich diff trying to render
# fonts/slick.svg as an image. It is an SVG *font* — <defs><font> with no
# viewBox and nothing drawable — so the image renderer reports "Invalid image
# source" instead of showing the diff.
/blocks/carousel/slick/** linguist-vendored
/blocks/carousel/slick/fonts/*.svg -diff
