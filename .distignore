*.njsproj
*.sln
*.sw?

# Logs
*.log
# Pattern validator run logs (@imwz/wp-pattern-sentinel). Gitignored, so a
# CI zip never sees one, but a working-copy rsync to a test site would.
sentinel-*.log.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

