{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "aludra/free-shipping-bar",
	"version": "1.0.0",
	"title": "Free Shipping Progress",
	"category": "aludra-convert",
	"icon": "airplane",
	"description": "Shows how far the WooCommerce cart is from free shipping, with a progress bar that updates as items are added or removed. Needs WooCommerce and a free shipping method with a minimum order amount.",
	"keywords": [ "shipping", "woocommerce", "cart", "progress" ],
	"example": {},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"text": true,
			"background": false
		},
		"typography": {
			"fontSize": true
		}
	},
	"textdomain": "aludra",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"attributes": {
		"threshold": {
			"type": "number",
			"default": 0
		}
	}
}
